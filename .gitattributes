* text=auto eol=lf

# Scripts executados diretamente pelo Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Imagens e artefatos binários não recebem normalização de linha.
*.png binary
*.ico binary
*.icns binary
*.webp binary
*.wav binary

# Pesos locais necessários ao instalador. O arquivo ONNX externo excede o
# limite normal do GitHub e deve ser armazenado via Git LFS.
src-tauri/resources/models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
src-tauri/resources/models/**/*.onnx_data filter=lfs diff=lfs merge=lfs -text
src-tauri/resources/models/**/*.bin filter=lfs diff=lfs merge=lfs -text
src-tauri/resources/models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
src-tauri/resources/models/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text
